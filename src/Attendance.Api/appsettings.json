{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Properties": {
      "Application": "Nordwin.Attendance.Api"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "nordwin-attendance-api",
    "Audience": "nordwin-attendance-client"
  },
  "Auth": {
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "7.00:00:00",
    "MaxFailedLoginAttempts": 5,
    "LockoutDuration": "00:15:00",
    "PasswordResetLinkLifetime": "00:30:00"
  },
  "Email": {
    "From": "Nordwin Attendance <no-reply@nordwin.example>"
  },
  "Database": {
    "MigrateOnStartup": true
  }
}
