# Copy to .env.local. Server-side settings of the BFF; none of them reach the browser.

# The Nordwin Attendance API. Only the Next.js server calls it; the browser talks to this app's /api routes.
API_BASE_URL=http://localhost:5216

# Reverse proxies in front of Next.js that append to X-Forwarded-For (0 = Next.js is exposed directly).
TRUSTED_PROXY_HOPS=0
